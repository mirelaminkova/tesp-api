// Nextflow + nf-ga4gh against a local TESP-API stack (docker compose --profile pulsar).
// See tests/README.md, "Nextflow end-to-end test". Credentials come from the
// environment (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY), never from this file.

plugins {
    id 'nf-ga4gh@1.5.0'
}

tes {
    endpoint = System.getenv('TES_ENDPOINT') ?: 'http://localhost:8080'
}

// TESP-API presigns these s3:// URLs against its own s3.endpoint_url, so this
// must be the same object store (the MinIO service of the compose stack).
workDir = System.getenv('NXF_E2E_WORK_DIR') ?: 's3://nextflow-e2e/work'

aws {
    region = 'us-east-1'
    client {
        endpoint = System.getenv('S3_ENDPOINT') ?: 'http://172.17.0.1:9000'
        s3PathStyleAccess = true
    }
}

process {
    executor = 'tes'
    container = 'ubuntu:24.04'
}
